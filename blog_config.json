  "article_detection": {
    "url_patterns": [
      "/blog/",
      "/articles/",
      "/posts/",
      "/news/",
      "/insights/",
      "/updates/",
      "/docs/",
      "/guides/",
      "/tutorials/"
    ],
    "exclude_patterns": [
      "/author/",
      "/tag/",
      "/category/",
      "/page/",
      "/search",
      "/feed",
      "/rss",
      "/sitemap"
    ],
    "title_exclude_patterns": [
      "blog",
      "author",
      "tag",
      "category",
      "search",
      "page"
    ],
    "min_title_length": 10,
    "max_depth": 4
  },
  "crawl_settings": {
    "max_pages": 1000,
    "max_depth": 4,
    "timeout": 30,
    "delay": 0.5
  }
